# NearPayments — crypto contribution widget (server-only, never exposed to client)
NEARPAYMENTS_API_KEY=
NEARPAYMENTS_IPN_SECRET=

# Admin panel (/admin) — server-only
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Cloudflare Turnstile — bot protection on contact form + vault creation
# Site key is fetched by the client via a server function, so it doesn't
# need a VITE_ prefix. Secret key is server-only, never exposed to client.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
